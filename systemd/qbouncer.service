[Unit]
Description=qBouncer - WireGuard NAT-PMP Port Bouncer for qBittorrent
Documentation=https://github.com/vegardx/qbouncer
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/qbouncer/venv/bin/qbouncer --config /etc/qbouncer/qbouncer.toml

# Optional credential-manager integration. Drop a file at
# /etc/qbouncer/credentials/qbt_password (mode 0600) and uncomment both
# lines below; qbouncer reads the file instead of the plaintext password
# in qbouncer.toml. Leave commented to use the password from config/env.
# LoadCredential=qbt_password:/etc/qbouncer/credentials/qbt_password
# Environment=QBOUNCER_QBT_PASSWORD_FILE=%d/qbt_password

# Watchdog configuration
WatchdogSec=90
Restart=on-failure
RestartSec=10

# Security hardening
User=qbouncer
Group=qbouncer
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
# iputils ping (the health check) calls capset and setuid to drop privileges;
# @privileged would make both fail with EPERM and every health check fail.
SystemCallFilter=capset setuid
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
LockPersonality=yes

# Required capabilities
# CAP_NET_RAW: ping for health checks
# CAP_NET_ADMIN: iptables and `wg show` for the killswitch (optional feature)
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Directories
RuntimeDirectory=qbouncer
StateDirectory=qbouncer
ReadWritePaths=/var/lib/qbouncer

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qbouncer

[Install]
WantedBy=multi-user.target
